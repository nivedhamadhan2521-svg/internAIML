                             p.patient_name,
                             CONCAT(r.room_number, ' – ', r.room_type),
                             ad.admission_date,
                             ad.discharge_date
                      FROM admissions ad
                               JOIN patient_s p ON ad.patient_id = p.patient_id
                               JOIN rooms r ON ad.room_id = r.room_id
                      ORDER BY ad.admission_id""", fetch=True)
